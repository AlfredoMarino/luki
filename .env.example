# HuggingFace access token — required to download gated models like DINOv3.
#
# 1. Create a read token at: https://huggingface.co/settings/tokens
# 2. Accept the model license at: https://huggingface.co/facebook/dinov3-vitl16-pretrain-lvd1689m
# 3. Copy this file to `.env` and paste your token below.
#
# Docker Compose loads `.env` automatically, exposing HF_TOKEN to the api and app services.
HF_TOKEN=hf_your_token_here
